FACTORY_WORK_ROOT=/home/hermes/.local/share/danny-dark-factory/self-hosting-worktrees
FACTORY_CODEX_HOME=/home/hermes/.local/share/danny-dark-factory/codex-home
FACTORY_REPO_SLUG=Danny-agent/danny-dark-factory
FACTORY_RUNNER_SHA=REPLACE_WITH_APPROVED_MERGE_SHA
FACTORY_BASE=main
