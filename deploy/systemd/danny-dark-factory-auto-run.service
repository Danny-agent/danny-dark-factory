[Unit]
Description=Run one queued dark-factory task to a verified draft PR
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
EnvironmentFile=%h/.config/danny-dark-factory/auto-run.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/projects/danny-dark-factory-runner
ExecStart=/usr/bin/python3 %h/projects/danny-dark-factory-runner/scripts/auto_run_once.py
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ExitType=cgroup
KillMode=control-group
TimeoutStopSec=30s
RuntimeMaxSec=45min
